<Window x:Class="WingetGui.LeftoverReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:WingetGui.Models"
        mc:Ignorable="d"
        Title="WinGet GUI - Residual Traces Cleaner"
        Icon="assets/app.ico"
        Height="540" Width="740"
        MinHeight="440" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushCanvas}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource DefaultFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- GridViewColumnHeader Style -->
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="{StaticResource BrushHeader}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListViewItem Zebra Striping -->
        <Style x:Key="LeftoverRowStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushRowEven}" />
                            </Trigger>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushRowOdd}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushRowHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushRowSelected}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Toolbar / Quick Select -->
            <RowDefinition Height="*" />    <!-- Leftovers List -->
            <RowDefinition Height="Auto" /> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="{StaticResource BrushHeader}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Clean Shield Icon -->
                <Border Grid.Column="0" Width="36" Height="36" Background="#094771" CornerRadius="4" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                          Fill="#1C97EA" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Residual Traces Detected" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="Review leftover files, folders, and registry entries before permanent removal." FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Toolbar / Summary Bar -->
        <Border Grid.Row="1" Background="{StaticResource BrushCanvas}" Padding="16,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Select All" Click="OnSelectAllClick" Style="{StaticResource WindowActionButtonStyle}" Padding="10,4" Margin="0,0,6,0" />
                    <Button Content="Deselect All" Click="OnDeselectAllClick" Style="{StaticResource WindowActionButtonStyle}" Padding="10,4" />
                </StackPanel>

                <TextBlock x:Name="TxtItemsCountSummary" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
            </Grid>
        </Border>

        <!-- 3. Leftovers ListView -->
        <ListView x:Name="LeftoversListView"
                  Grid.Row="2"
                  Background="{StaticResource BrushCanvas}"
                  BorderThickness="0"
                  ItemContainerStyle="{StaticResource LeftoverRowStyle}"
                  AlternationCount="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <!-- Checkbox Column -->
                    <GridViewColumn Width="38">
                        <GridViewColumnHeader>
                            <CheckBox x:Name="ChkHeaderAll" IsChecked="True" Click="OnHeaderCheckToggled" Margin="2,0,0,0" ToolTip="Toggle All" />
                        </GridViewColumnHeader>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:LeftoverItem}">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="OnItemCheckChanged" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Type Badge -->
                    <GridViewColumn Header="Type" Width="84">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:LeftoverItem}">
                                <Border Background="{Binding KindBadgeColor}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KindBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Path / Location -->
                    <GridViewColumn Header="Residual Path / Registry Key" Width="440">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:LeftoverItem}">
                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Size -->
                    <GridViewColumn Header="Size" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:LeftoverItem}">
                                <TextBlock Text="{Binding FormattedSize}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 4. Footer Actions -->
        <Border Grid.Row="3" Background="{StaticResource BrushHeader}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtSelectedSummary" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" FontWeight="SemiBold" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Skip" Click="OnSkipClick" Style="{StaticResource WindowActionButtonStyle}" Padding="16,6" Margin="0,0,10,0" ToolTip="Skip residual cleaning and keep these items" />
                    <Button x:Name="BtnDelete" Content="Delete Leftovers" Click="OnDeleteClick" Background="{StaticResource BrushAccent}" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="18,6" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="3" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
